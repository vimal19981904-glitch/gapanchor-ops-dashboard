generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Finance ────────────────────────────────────────
model Transaction {
  id              String   @id @default(cuid())
  date            DateTime
  type            String   // "income" | "expense"
  sourceOrCategory String
  platform        String?  // Manhattan WMS, Blue Yonder, Kinaxis, SAP
  amount          Float
  paymentMethod   String   // UPI, Cash, Bank Transfer, Credit Card
  notes           String?
  quarter         String   // Q1, Q2, Q3, Q4
  year            Int
  origin          String   @default("manual") // "manual" | "outlook_email" | "auto_sync"
  outlookMessageId String? // Graph API message ID if parsed from email
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Training & Finance Tracking ────────────────────
model Session {
  id                     String               @id @default(cuid())
  title                  String
  platform               String               // Manhattan WMS, Blue Yonder, Kinaxis, SAP S/4HANA
  trainer                String               @default("Arul Xavier")
  participantsCount      Int                  @default(0)
  currentlyParticipating Int                  @default(0)
  date                   DateTime
  time                   String?
  status                 String               @default("Scheduled") // Scheduled, In Progress, Completed
  quarter                String               @default("Q3")
  location               String?
  calendarEventId        String?              // Outlook calendar event ID
  trainerTotalCost       Float                @default(0) // Trainer Overall Amount (manual entry, e.g. ₹100,000)
  trainerAmountPaid      Float                @default(0) // Trainer Paid Amount (e.g. ₹50,000)
  trainerAmountDue       Float                @default(0) // Trainer Due / Payable Amount (Auto-calculated: trainerTotalCost - trainerAmountPaid)
  participants           SessionParticipant[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model SessionParticipant {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantName String
  amountDue       Float    @default(0)
  amountPaid      Float    @default(0)
  paymentStatus   String   @default("PENDING") // PAID, PARTIAL, PENDING
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sessionId])
  @@index([paymentStatus])
}

// ─── WhatsApp Comms / Enquiries ─────────────────────
model Enquiry {
  id                String    @id @default(cuid())
  participantName   String
  email             String?
  phone             String
  country           String?
  serviceType       String?
  trainingType      String?
  topic             String
  lastMessage       String?
  messageTimestamp   DateTime
  dateSubmitted     DateTime?
  receivedDate      DateTime?
  leadQuality       String    @default("Unrated") // Unrated, High, Medium, Low
  contactStatus     String    @default("Pending") // Pending, Talked, In Touch, Converted, Lost
  isStale           Boolean   @default(false)
  status            String    @default("Open") // Open, Active, Action Required, Processed, Resolved
  staleReason       String?
  processedAt       DateTime? // When "Process" button was clicked
  processedNotes    String?   // Notes added during processing
  assignedToId      String?   // Assigned employee/user ID
  assignedToName    String?   // Assigned employee/user name
  assignedTo        User?     @relation("AssignedEnquiries", fields: [assignedToId], references: [id])
  source            String    @default("whatsapp") // whatsapp, manual, outlook, excel
  whatsappMessageId String?   // WhatsApp Cloud API or Outlook message ID
  monitoringAudit   LeadMonitoringAudit?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─── Lead Status Monitoring & Alert Cron Models ──────
model LeadMonitoringAudit {
  id               String    @id @default(cuid())
  enquiryId        String    @unique
  enquiry          Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  pendingStartTime DateTime
  firstAlertSentAt DateTime?
  lastAlertSentAt  DateTime?
  alertCount       Int       @default(0)
  statusChangedAt  DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive])
  @@index([pendingStartTime])
}

model CronExecutionLog {
  id                         String   @id @default(cuid())
  executionTimestamp         DateTime @default(now())
  leadsCheckedCount          Int      @default(0)
  firstAlertsSentCount       Int      @default(0)
  recurringAlertsSentCount   Int      @default(0)
  statusChangesDetectedCount Int      @default(0)
  errorsEncountered          String?  // JSON string array of error messages
  executionDurationMs        Int      @default(0)
  nextExecutionTime          DateTime?
}

// ─── Users / Employee Access ────────────────────────

// ─── Users / Employee Access ────────────────────────
model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  role              String    @default("employee") // "admin" | "employee"
  assignedCourse    String?   // "Manhattan WMS" | "Blue Yonder" | "Kinaxis" | "SAP S/4HANA"
  assignedEnquiries Enquiry[] @relation("AssignedEnquiries")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─── Dev Progress ───────────────────────────────────
model DevLog {
  id          String   @id @default(cuid())
  quarter     String
  title       String
  type        String   @default("feature") // feature, fix, infra
  description String
  date        DateTime
  shippedBy   String   @default("Antigravity Team")
  commitSha   String?  // GitHub commit SHA if from API
  prNumber    Int?     // GitHub PR number
  createdAt   DateTime @default(now())
}

// ─── Integration Config (runtime state) ─────────────
model IntegrationConfig {
  id          String   @id @default(cuid())
  service     String   @unique // "microsoft_graph" | "whatsapp" | "github"
  connected   Boolean  @default(false)
  metadata    String?  // JSON string with service-specific config
  lastSynced  DateTime?
  updatedAt   DateTime @updatedAt
}
